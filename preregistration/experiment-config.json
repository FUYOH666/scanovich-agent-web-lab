{
  "experiment_id": "AW-004",
  "title": "Representations for AI agents",
  "started_on": "2026-08-08",
  "status": "open",
  "phase": {
    "current": "0",
    "definitions": {
      "0": "surface_verification",
      "1": "controlled_representation_comparison",
      "2": "external_agent_observations"
    }
  },
  "live": {
    "hub": "https://scanovich.ai/research/agent-web/",
    "brief": "https://scanovich.ai/research/agent-web/aw-004/",
    "bring_your_agent": "https://scanovich.ai/research/agent-web/bring-your-agent/",
    "observatory": "https://scanovich.ai/research/agent-web/observatory/"
  },
  "variants": {
    "A": "semantic_html",
    "B": "html_jsonld",
    "C": "markdown",
    "D": "decision_packet"
  },
  "baskets": ["synthetic", "product_probe", "crawler", "organic"],
  "intent_corpus_v0.1": {
    "public_examples": 20,
    "private_holdouts": 60,
    "adversarial_holdouts": 20,
    "public_path": "datasets/synthetic/public/",
    "sealed_digest_file": "preregistration/holdout-manifest.sha256"
  },
  "scoring": {
    "post_hoc_gold_labels": false,
    "require_rubric_freeze_before_runs": true,
    "rubric_schema": "schemas/scoring-rubric.schema.json",
    "order": [
      "freeze_intents",
      "freeze_scoring_rubric",
      "hash",
      "run_models",
      "blind_annotation",
      "score"
    ]
  },
  "primary_metrics": {
    "phase_0": ["fetch.requested_vs_served", "fetch.fetch_success"],
    "phase_1_2": [
      "exposure_by_variant_origin_family",
      "understanding.entity_when_labeled",
      "understanding.capabilities_score_mean_when_labeled",
      "understanding.constraints_score_mean_when_labeled"
    ]
  },
  "secondary_metrics": ["citation.present", "action.occurred"],
  "stopping_condition": {
    "any_of": [
      { "unique_external_agent_fetches": 100 },
      { "independent_human_origins_with_pasteback": 30 },
      { "calendar_days_from_start": 30 }
    ]
  },
  "contamination_policy": {
    "publish_gold_labels": false,
    "publish_holdout_prompts_before_close": false,
    "publish_scoring_rubrics_before_close": false,
    "agents_md_ground_truth": false
  },
  "schemas": {
    "fetch": "schemas/fetch.schema.json",
    "observation": "schemas/observation.schema.json",
    "run": "schemas/run.schema.json"
  }
}
