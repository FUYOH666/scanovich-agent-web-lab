{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scanovich.ai/research/schemas/scanovich.agent_web_observation.v1.json",
  "title": "scanovich.agent_web_observation.v1",
  "description": "Agent-behavior observation (understanding → consideration → citation → action). HTTP exposure belongs in fetch.v1; bundle via run.v1. No PII, no gold labels.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment_id",
    "timestamp",
    "origin",
    "variant"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "scanovich.agent_web_observation.v1"
    },
    "observation_id": { "type": "string" },
    "run_id": {
      "type": "string",
      "description": "Parent run (scanovich.agent_web_run.v1)."
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^AW-[0-9]{3}$"
    },
    "phase": {
      "type": "string",
      "enum": ["0", "1", "2", "unknown"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "type": "string",
      "enum": ["synthetic", "product_probe", "crawler", "organic"]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "description": "Prefer honest unknown over omitting fields.",
      "properties": {
        "agent_family": { "type": "string" },
        "product": { "type": "string" },
        "product_version": { "type": "string" },
        "model": { "type": "string" },
        "model_version": { "type": "string" },
        "retrieval_mode": {
          "type": "string",
          "enum": ["none", "web_search", "browsing", "tool_fetch", "unknown"]
        },
        "tooling_mode": {
          "type": "string",
          "enum": ["none", "browser_agent", "api", "harness", "unknown"]
        },
        "temperature": { "type": ["number", "null"] },
        "locale": { "type": "string" },
        "region": { "type": "string" }
      }
    },
    "agent_family": {
      "type": "string",
      "description": "Deprecated alias; prefer environment.agent_family."
    },
    "product": {
      "type": "string",
      "description": "Deprecated alias; prefer environment.product."
    },
    "intent_id": { "type": "string" },
    "intent_class": {
      "type": "string",
      "enum": ["branded", "capability", "workflow", "vertical", "other"]
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "ambiguous", "multi_constraint"]
    },
    "repeat_index": {
      "type": "integer",
      "minimum": 1
    },
    "variant": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "unknown"]
    },
    "canon_url": {
      "type": "string",
      "format": "uri"
    },
    "fetch_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional summary of primary representation; prefer linked fetches for detail.",
      "properties": {
        "requested": {
          "type": "string",
          "enum": ["html", "markdown", "json", "jsonld", "decision_packet", "unknown"]
        },
        "served": {
          "type": "string",
          "enum": ["html", "markdown", "json", "jsonld", "decision_packet", "unknown"]
        }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional summary; prefer fetch.v1 records.",
      "properties": {
        "fetch_success": { "type": "boolean" },
        "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "understanding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity": { "type": "boolean" },
        "capabilities_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "constraints_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "unsupported_claims": { "type": "integer", "minimum": 0 }
      }
    },
    "consideration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "included": { "type": "boolean" },
        "rank": { "type": "integer", "minimum": 1 }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "present": { "type": "boolean" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "occurred": { "type": "boolean" },
        "kind": {
          "type": "string",
          "enum": ["none", "contact", "tool_call", "human_handoff", "other"]
        }
      }
    },
    "notes": { "type": "string" }
  }
}
